<html>
<head>
    <title>Purchase Goods - Transport Facility</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet"/>
</head>
<body class="bg-gray-100 font-roboto">
    <div class="container mx-auto p-4">
        <header class="flex justify-between items-center py-4">
            <h1 class="text-3xl font-bold">Transport Facility</h1>
            <nav>
                <ul class="flex space-x-4">
                    <li><a href="#" class="text-blue-500 hover:underline">Home</a></li>
                    <li><a href="#" class="text-blue-500 hover:underline">Services</a></li>
                    <li><a href="#" class="text-blue-500 hover:underline">Contact</a></li>
                </ul>
            </nav>
        </header>

        <main class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold mb-4">Goods Available for Purchase</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white">
                    <thead>
                        <tr>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Item Name</th>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Size</th>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Weight</th>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Price Range</th>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Purchase Year</th>
                            <th class="py-2 px-4 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">Contact</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Wooden Crate</td>
                            <td class="py-2 px-4 border-b border-gray-300">100x50x50 cm</td>
                            <td class="py-2 px-4 border-b border-gray-300">50kg</td>
                            <td class="py-2 px-4 border-b border-gray-300">$100 - $150</td>
                            <td class="py-2 px-4 border-b border-gray-300">2020</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 890</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Metal Container</td>
                            <td class="py-2 px-4 border-b border-gray-300">200x100x100 cm</td>
                            <td class="py-2 px-4 border-b border-gray-300">200kg</td>
                            <td class="py-2 px-4 border-b border-gray-300">$500 - $700</td>
                            <td class="py-2 px-4 border-b border-gray-300">2019</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 891</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Cardboard Boxes</td>
                            <td class="py-2 px-4 border-b border-gray-300">30x30x30 cm each</td>
                            <td class="py-2 px-4 border-b border-gray-300">10kg each</td>
                            <td class="py-2 px-4 border-b border-gray-300">$5 - $10 each</td>
                            <td class="py-2 px-4 border-b border-gray-300">2021</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 892</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Plastic Barrel</td>
                            <td class="py-2 px-4 border-b border-gray-300">60x60x100 cm</td>
                            <td class="py-2 px-4 border-b border-gray-300">25kg</td>
                            <td class="py-2 px-4 border-b border-gray-300">$50 - $80</td>
                            <td class="py-2 px-4 border-b border-gray-300">2018</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 893</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Pallet</td>
                            <td class="py-2 px-4 border-b border-gray-300">120x80x150 cm</td>
                            <td class="py-2 px-4 border-b border-gray-300">500kg</td>
                            <td class="py-2 px-4 border-b border-gray-300">$200 - $300</td>
                            <td class="py-2 px-4 border-b border-gray-300">2017</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 894</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-4 border-b border-gray-300">Large Sack</td>
                            <td class="py-2 px-4 border-b border-gray-300">50x50x80 cm</td>
                            <td class="py-2 px-4 border-b border-gray-300">20kg</td>
                            <td class="py-2 px-4 border-b border-gray-300">$20 - $30</td>
                            <td class="py-2 px-4 border-b border-gray-300">2022</td>
                            <td class="py-2 px-4 border-b border-gray-300">+1 234 567 895</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>

        <footer class="mt-8 text-center text-gray-600">
            <p>&copy; 2023 Transport Facility. All rights reserved.</p>
        </footer>
    </div>
</body>
</html>