<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>LoginChecker</servlet-name>
        <servlet-class>controller.LoginChecker</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Registerchecker</servlet-name>
        <servlet-class>controller.Registerchecker</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>WareHouseStorage</servlet-name>
        <servlet-class>controller.WareHouseStorage</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UserChecker</servlet-name>
        <servlet-class>controller.UserChecker</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Seller</servlet-name>
        <servlet-class>controller.Seller</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginChecker</servlet-name>
        <url-pattern>/LoginChecker</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Registerchecker</servlet-name>
        <url-pattern>/Registerchecker</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>WareHouseStorage</servlet-name>
        <url-pattern>/WareHouseStorage</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserChecker</servlet-name>
        <url-pattern>/UserChecker</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Seller</servlet-name>
        <url-pattern>/Seller</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>
</web-app>
